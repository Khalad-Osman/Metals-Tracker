// Cloudflare Workers configuration for the public demo frontend.
// The site is plain static files: Cloudflare serves whatever `npm run build` puts in dist/.
{
  "name": "metals-tracker",
  "compatibility_date": "2026-09-01",
  "assets": {
    "directory": "./dist",
    // Unknown paths get index.html instead of a 404, the usual setting for a React app.
    "not_found_handling": "single-page-application"
  }
}
